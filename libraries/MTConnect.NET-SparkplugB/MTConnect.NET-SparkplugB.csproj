<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup Condition="'$(Configuration)'=='Debug'">
    <TargetFrameworks>net8.0</TargetFrameworks>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)'!='Debug'">
    <TargetFrameworks>net6.0;net8.0</TargetFrameworks>
  </PropertyGroup>

  <PropertyGroup>
    <RootNamespace>MTConnect</RootNamespace>
    <Configurations>Debug;Release</Configurations>
  </PropertyGroup>

  <ItemGroup>
    <!-- protobuf-net encodes the Sparkplug B payload from the hand-written contract in
         Payload/. MQTTnet is the MQTT client the Sparkplug session is built on. Both were
         previously pulled in transitively by SparkplugNet, which this library no longer
         uses: the Sparkplug session, topics, sequence numbers and payload encoding are all
         owned here now. -->
    <PackageReference Include="protobuf-net" Version="3.2.30" />
    <PackageReference Include="MQTTnet" Version="4.3.7.1207" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\MTConnect.NET-Common\MTConnect.NET-Common.csproj" />
  </ItemGroup>

</Project>
