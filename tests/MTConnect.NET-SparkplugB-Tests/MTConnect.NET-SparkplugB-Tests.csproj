<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>MTConnect.SparkplugB.Tests</RootNamespace>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.4.0" />
    <PackageReference Include="NUnit" Version="3.13.3" />
    <PackageReference Include="NUnit3TestAdapter" Version="4.3.1" />
    <!-- Test-only. The library no longer uses SparkplugNet, but its ProtoBuf model was
         generated from Eclipse's official schema, which makes it an independent reference to
         check our hand-written payload contract against. Comparing two independently written
         contracts catches a wrong field number, which round-tripping against ourselves cannot. -->
    <PackageReference Include="SparkplugNet" Version="1.3.10" />
    <PackageReference Include="coverlet.collector" Version="6.0.4">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\libraries\MTConnect.NET-SparkplugB\MTConnect.NET-SparkplugB.csproj" />
  </ItemGroup>

</Project>
