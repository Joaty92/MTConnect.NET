<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup Condition="'$(Configuration)'=='Debug'">
    <TargetFrameworks>net8.0</TargetFrameworks>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)'!='Debug'">
    <TargetFrameworks>net6.0;net8.0</TargetFrameworks>
  </PropertyGroup>

  <PropertyGroup>
    <RootNamespace>MTConnect</RootNamespace>
    <Configurations>Debug;Release</Configurations>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\libraries\MTConnect.NET-OpcUa\MTConnect.NET-OpcUa.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="profiles\*.yaml" CopyToOutputDirectory="PreserveNewest" />
    <!-- Preferred template name: *.template.xml. *.device.xml retained for back-compat. -->
    <Content Include="profiles\*.template.xml" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="profiles\*.device.xml" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
