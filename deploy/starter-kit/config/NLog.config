<?xml version="1.0" encoding="utf-8" ?>
<nlog xmlns="http://www.nlog-project.org/schemas/NLog.xsd" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
  <targets>
    <target name="logconsole" xsi:type="Console"
      layout="${longdate}|${uppercase:${level}}|${logger}|${message}" />
    <target xsi:type="File" name="module-file"
      fileName="/app/logs/${logger}-${shortdate}.log"
      archiveFileName="/app/logs/archive/${logger}-${shortdate}.{#}.log"
      archiveAboveSize="10485760"
      archiveNumbering="Sequence"
      maxArchiveFiles="30"
      concurrentWrites="false"
      keepFileOpen="true"
      layout="${longdate}|${uppercase:${level}}|${logger}|${message} ${exception:format=tostring}" />
  </targets>
  <rules>
    <logger name="*" minlevel="Info" writeTo="logconsole" />
    <logger name="modules.*" minlevel="Information" writeTo="module-file" final="true" />
    <logger name="Microsoft.*" maxlevel="Warning" final="true" />
    <logger name="System.Net.Http.*" maxlevel="Warning" final="true" />
  </rules>
</nlog>
